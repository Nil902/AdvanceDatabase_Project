# -----------------------------------------------------------------------------
# Production secrets for the Civil Registry stack.
#
# On the server this file lives OUTSIDE the repo at:
#     /opt/civil-registry/.env.production
# and is referenced by docker-compose.prod.yml via `env_file:`. It must exist
# (with real values) BEFORE `docker compose -f docker-compose.prod.yml up`, or
# the app and postgres containers will fail to start.
#
# This example is committed with EMPTY values only. Never commit real secrets.
# Generate strong values, e.g.:
#     APP_KEY:  docker run --rm laravelsail/php83-composer php -r "echo 'base64://'.base64_encode(random_bytes(32)).PHP_EOL;"
#               (or `php artisan key:generate --show` in the Backend dir)
#     passwords: openssl rand -base64 32
# -----------------------------------------------------------------------------

# Laravel application key. The previously committed key is COMPROMISED — rotate.
APP_KEY=

# Postgres superuser (used by the postgres container init + migrations).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Application's Postgres login: the least-privilege civil_app role (DML only).
# DB_PASSWORD is also used to provision that role (fresh volume: init script;
# existing DB: deploy/provision-db-role.sql). The two MUST match.
DB_USERNAME=civil_app
DB_PASSWORD=

# MongoDB root (admin) user — created on a fresh volume; on an existing volume
# create it via the localhost exception (see deploy/provision-mongo-user.js).
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=

# Application's Mongo login: least-privilege civil_app (readWrite on
# civil_registry_docs only). Avoid single-quote characters in this password.
MONGO_USERNAME=civil_app
MONGO_PASSWORD=

# Photo/scan/avatar storage. Set PHOTO_DISK=r2 to store PII files on Cloudflare
# R2 (the bucket stays PRIVATE — files are streamed through the app). After
# switching, run inside the app container: php artisan photos:migrate --from=public
PHOTO_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_USE_PATH_STYLE=true

# pgBadger reports are served at /pgbadger/ behind HTTP Basic Auth (the reports
# contain query text with PII). Choose any username and a strong password, then
# share them with the admins who need the DB performance reports. If the
# password is left blank the endpoint auto-locks with a random one.
PGBADGER_AUTH_USER=pgbadger
PGBADGER_AUTH_PASSWORD=
