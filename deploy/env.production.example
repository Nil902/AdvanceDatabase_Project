# -----------------------------------------------------------------------------
# Production secrets for the Civil Registry stack.
#
# On the server this file lives OUTSIDE the repo at:
#     /opt/civil-registry/.env.production
# and is referenced by docker-compose.prod.yml via `env_file:`. It must exist
# (with real values) BEFORE `docker compose -f docker-compose.prod.yml up`, or
# the app and postgres containers will fail to start.
#
# This example is committed with EMPTY values only. Never commit real secrets.
# Generate strong values, e.g.:
#     APP_KEY:  docker run --rm laravelsail/php83-composer php -r "echo 'base64://'.base64_encode(random_bytes(32)).PHP_EOL;"
#               (or `php artisan key:generate --show` in the Backend dir)
#     passwords: openssl rand -base64 32
# -----------------------------------------------------------------------------

# Laravel application key. The previously committed key is COMPROMISED — rotate.
APP_KEY=

# Postgres superuser (used by the postgres container init + migrations).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Application's Postgres login. Least-privilege role created in 1.2 (civil_app).
# Until that role is provisioned this may be the superuser; switch to civil_app after.
DB_USERNAME=postgres
DB_PASSWORD=
